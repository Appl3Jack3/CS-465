<!DOCTYPE html>
<!--Website template by freewebsitetemplates.com -->
<html>
<head>
	 <meta charset="UTF-8">
     <title>Travel - Bhaccasyoniztas Beach Resort</title>
     <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
     <div id="background">
			<div id="page">
        		{{> header }}
    			<div id="contents">
      				<div class="box">
						<div>
							<div class="body">
		  						<h1>Travel</h1>
		  						<ul id="sites">
				{{#each trips}}
			  						<li>
										<a href="/travel/{{this.name}}">
				  							<img src="/images/{{this.image}}" alt="{{this.name}}">
										</a>
										<h2>{{this.name}}</h2>
										{{{this.description}}}
			  						</li>
				{{/each}}
		  						</ul>
							</div>
	  					</div>
       				    {{> footer }}
 				 </div>
			</body>
		</html>
